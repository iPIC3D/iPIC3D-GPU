---
BasedOnStyle: LLVM
Language: Cpp
Standard: c++17

# Core layout. The narrow limit keeps deeply nested CUDA and stencil code
# readable in side-by-side diffs.
ColumnLimit: 80
IndentWidth: 2
ContinuationIndentWidth: 4
UseTab: Never
BreakBeforeBraces: Attach
BreakBeforeBinaryOperators: None
AlignOperands: Align

# Compact simple helpers without collapsing control flow.
AllowShortFunctionsOnASingleLine: All
AllowShortLambdasOnASingleLine: All
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false
IndentCaseLabels: false

# Preserve intentional include groups while sorting within each group.
SortIncludes: true
IncludeBlocks: Preserve

# Match the existing `Type* name` and `Type& name` convention.
DerivePointerAlignment: false
PointerAlignment: Left
ReferenceAlignment: Left

# Keep documentation and neighboring definitions consistent with the current
# codebase rather than introducing a second bulk restyle.
ReflowComments: Always
SeparateDefinitionBlocks: Leave
FixNamespaceComments: true

# Make generated output deterministic across platforms.
LineEnding: LF
InsertNewlineAtEOF: true
...
