# Runtime input options configured for this 3D Taylor-Green flow test.
# Controls for other cases or disabled features are kept at inert defaults.
# Compile-time constants in iPIC3Dlib.cu are not input-file options.
# Brackets show the value used when a key is omitted; required keys have no default.

# %%%%%%%%%%%%%%%%%%%% RUN AND I/O %%%%%%%%%%%%%%%%%%%%
SaveDirName    = data                   # Fresh-run output directory [default: data]
RestartDirName = data                   # Checkpoint directory [default: data]
Case           = TaylorGreen            # Case-sensitive initialization case [required]
SimulationName = TaylorGreen            # Output dataset name [required]
# Field backends (build-dependent): shdf5, phdf5, pvtk, nbcvtk.
FieldWriteMethod = pvtk                 # [required]

# %%%%%%%%%%%%%%%%%%%% TIME INTEGRATION %%%%%%%%%%%%%%%%%%%%
dt      = 0.15                          # Time step [required]
ncycles = 2001                          # Cycles in this run [required]
th      = 1.0                           # Implicit decentering parameter [default: 1.0]
c       = 1.0                           # Normalized light speed [default: 1.0]

# %%%%%%%%%%%%%%%%%%%% INITIAL FIELDS %%%%%%%%%%%%%%%%%%%%
# TaylorGreen initialization uses B0x as the field amplitude; B0y/B0z are unused.
B0x = 0.00577                           # [default: 0.0]
B0y = 0.0                               # [default: 0.0]
B0z = 0.0                               # [default: 0.0]

Smooth      = 0.5                       # Smoothing coefficient; 1 disables [default: 1.0]
SmoothNiter = 6                         # Smoothing passes [default: 6]

PoissonCorrection      = no             # Exact "yes" enables div(E) cleaning [default: no]
PoissonCorrectionCycle = 10             # div(E) cleaning interval [default: 10]
divBCorrection         = no             # Exact "yes" enables div(B) cleaning [default: no]
divBCorrectionCycle    = 10             # div(B) cleaning interval [default: 10]

# %%%%%%%%%%%%%%%%%%%% DOMAIN AND TOPOLOGY %%%%%%%%%%%%%%%%%%%%
Lx = 10.0                               # Global x length [default: 10.0]
Ly = 10.0                               # Global y length [default: 10.0]
Lz = 10.0                               # Global z length [default: 10.0]

nxc = 64                                # Global x cells [default: 64]
nyc = 64                                # Global y cells [default: 64]
nzc = 64                                # Global z cells [default: 64]

# XLEN*YLEN*ZLEN must equal the MPI process count.
XLEN = 4                                # MPI subdomains in x [default: 1]
YLEN = 4                                # MPI subdomains in y [default: 1]
ZLEN = 4                                # MPI subdomains in z [default: 1]

# Periodicity; omitted particle flags inherit these values. 1=periodic, 0=nonperiodic.
PERIODICX = 1                           # [default: true]
PERIODICY = 1                           # [default: true]
PERIODICZ = 1                           # [default: true]

# %%%%%%%%%%%%%%%%%%%% PARTICLES %%%%%%%%%%%%%%%%%%%%
# Species: e-, i+.
ns = 2                                  # Total species count [required]

# Initial density
rhoINIT   = 1.0  1.0                    # Initial densities [required]
rhoINJECT = 0.0  0.0                    # Boundary injection densities [required]

npcelx = 4  4                           # Particles per cell in x [required]
npcely = 4  4                           # Particles per cell in y [required]
npcelz = 4  4                           # Particles per cell in z [required]

# qom = charge to mass ratio for different species
#     e      i
qom = -25.0  1.0                        # [required]

# Thermal velocity
uth = 0.02  0.00894                     # x thermal speeds [required]
vth = 0.02  0.00894                     # y thermal speeds [required]
wth = 0.02  0.00894                     # z thermal speeds [required]

# Taylor-Green flow amplitude: u0 of species 0; every species flows with it
# (v0, w0 unused by this case)
u0 = 0.01  0.01                         # [required]
v0 = 0.0   0.0                          # [required]
w0 = 0.0   0.0                          # [required]

TrackParticleID = 0  0                  # Per-species ID mask [default: all 0]

SortingCycle = 1                        # GPU cell-sort interval; 0 disables [default: 0]

# %%%%%%%%%%%%%%%%%%%% DATA ANALYSIS %%%%%%%%%%%%%%%%%%%%
# Velocity histograms, their GMM fit and the macrocell (v_par, v_perp) spectra,
# every DataAnalysisCycle cycles. Ranges and GMM settings: README, "Data analysis".
DataAnalysisCycle      = 50             # Analysis interval; 0 disables [default: 50]
DataAnalysisOutputDir  = ./             # Parent folder of the outputs [default: ./]
VelocityHistogram      = 0              # 3D velocity histograms [default: 0]
VelocityHistGMMSpecies = 1 1            # Per-species mask of the histograms and GMM [default: all 1]
VelocityHistogramMacrocells = 0         # Histograms and GMM per macrocell, not per rank [default: 0]
VelocityGMM            = 0              # GMM fit of the histograms [default: 0]
GMMComponents          = 10             # Gaussians of each GMM fit, 1 to 256 [default: 10]
# The spectra and the macrocell histograms need macrocell sizes (at most the
# cells of a rank): MacrocellNx/Ny/Nz for both, or VelocitySpectraMacrocellNx/Ny/Nz
# and VelocityHistogramMacrocellNx/Ny/Nz for each. The spectra need a species.
VelocitySpectra        = 0              # Macrocell (v_par, v_perp) spectra [default: 0]
MacrocellNx            = 0              # Common macrocell x size in cells [default: 0]
MacrocellNy            = 0              # Common macrocell y size in cells [default: 0]
MacrocellNz            = 0              # Common macrocell z size in cells [default: 0]
VelocitySpectraSpecies = 0 0            # Per-species enable mask [default: all 0]

# %%%%%%%%%%%%%%%%%%%% BOUNDARY CONDITIONS %%%%%%%%%%%%%%%%%%%%
# Phi BC: 0/1=Dirichlet, 2=Neumann; periodicity overrides face values.
bcPHIfaceXright = 1                     # [default: 1]
bcPHIfaceXleft  = 1                     # [default: 1]
bcPHIfaceYright = 1                     # [default: 1]
bcPHIfaceYleft  = 1                     # [default: 1]
bcPHIfaceZright = 1                     # [default: 1]
bcPHIfaceZleft  = 1                     # [default: 1]

# EM BC: 0=conductor, 1=magnetic mirror, 2=open/inflow.
bcEMfaceXright = 0                      # [required]
bcEMfaceXleft  = 0                      # [required]
bcEMfaceYright = 0                      # [required]
bcEMfaceYleft  = 0                      # [required]
bcEMfaceZright = 0                      # [required]
bcEMfaceZleft  = 0                      # [required]

yes_sal      = 0                        # Enable absorbing layers [default: 1]
n_layers_sal = 3                        # Layer thickness in cells [default: 3]

# Particle BC: 0=exit, 1=mirror, 2=reemit, 3=open outflow, 4=open inflow.
bcPfaceXright = 1                       # [default: 1]
bcPfaceXleft  = 1                       # [default: 1]
bcPfaceYright = 1                       # [default: 1]
bcPfaceYleft  = 1                       # [default: 1]
bcPfaceZright = 1                       # [default: 1]
bcPfaceZleft  = 1                       # [default: 1]

ApplyInflowBcsEImage = 1                # Include inflow E terms [default: 1]

# %%%%%%%%%%%%%%%%%%%% NUMERICAL SOLVERS %%%%%%%%%%%%%%%%%%%%
CGtol      = 1E-3                       # CG tolerance; current call disabled [default: 1e-3]
GMREStol   = 1E-3                       # Maxwell GMRES/FGMRES tolerance [default: 1e-3]
DivCleaningTol = 1E-6                   # div(E)/div(B) cleaning tolerance [default: 1e-6]
NiterMover = 3                          # Predictor-corrector iterations [default: 3]

# GPU Maxwell solver:
SolverType = GMRES                      # [default: GMRES]

# Chebyshev preconditioner of the div(E)/div(B) cleaning solves.
PoissonChebMaxIter       = 20           # Preconditioner iterations [default: 20]
PoissonChebRescaleEigMin = 1.0          # Lower-bound multiplier [default: 1.0]
PoissonChebRescaleEigMax = 1.0          # Upper-bound multiplier [default: 1.0]
PoissonChebEigRatio      = 300          # eigMin floor eigMax/value, 0: exact bounds [default: 300]

# %%%%%%%%%%%%%%%%%%%% OUTPUT AND RESTART %%%%%%%%%%%%%%%%%%%%
# Tags are joined with +; an empty tag writes nothing.
# FieldOutputTag: B, E; Je, Ji, Je2, Ji3 (species 0-3 current), rho (total).
# MomentsOutputTag: rho, J, P (PXX..PZZ), Q (heat flux) or one component
# (PXX, Qxyz, ...) for all species; append a species index (rho0, J1, P2)
# for one species or _tot (rho_tot, J_tot, P_tot, Q_tot) for the sum.
# ParticlesOutputTag: position, velocity, q, ID; another token stops the run.
FieldOutputCycle       = 50                   # Field/moment interval; <=0 disables [default: 100]
FieldOutputTag         = B+E                  # Grid fields [default: empty]
MomentsOutputTag       = rho+J+P              # Species moments [default: empty]
ParticlesOutputCycle   = 0                    # Particle interval; <=0 disables [default: 0]
ParticlesOutputTag     = position+velocity+q  # Particle fields [default: empty]
ParticlesOutputSpecies = 1 1                  # Species whose particles are written [default: all 1]
ParticlesWriteMethod   = adios2               # Particle backend: adios2 or shdf5 [default: adios2 if built, else shdf5]
DiagnosticsOutputCycle = 10                   # Scalar interval [default: FieldOutputCycle]
RestartOutputCycle     = 0                    # Checkpoint interval; <=0 disables [default: 5000]
RestartWriteMethod     = adios2               # Checkpoint backend: adios2 or shdf5 [default: adios2 if built, else shdf5]
CallFinalize           = 1                    # Final checkpoint if restart output enabled [default: true]
