#ifndef IPIC3D_PARTICLE_ARRAY_CONFIG_H
#define IPIC3D_PARTICLE_ARRAY_CONFIG_H

// Generated by CMake from cmake/ParticleArrayConfig.h.in: the sizing of the
// device particle arrays, set by the CMake options PARTICLE_ARRAY_*.
namespace ParticleArrayConfig {

// initial capacity, times the particle count
inline constexpr double HEADROOM = @PARTICLE_ARRAY_HEADROOM@;
// an array grows when its particle count times this reaches its capacity
inline constexpr double RESIZE_THRESHOLD = @PARTICLE_ARRAY_RESIZE_THRESHOLD@;
// capacity of a grown array, times the particle count
inline constexpr double RESIZE_FACTOR = @PARTICLE_ARRAY_RESIZE_FACTOR@;

} // namespace ParticleArrayConfig

#endif // IPIC3D_PARTICLE_ARRAY_CONFIG_H
