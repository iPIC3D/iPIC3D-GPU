# Weak scaling, 16 nodes: GEM, 64x64x64 cells and a 10x10x10 domain per rank.
# 4 species of 280 particles per cell (a100).

SaveDirName = data
RestartDirName = data

Case              = GEM       # Select the case
PoissonCorrection = no        # Poisson correction
FieldWriteMethod  = pvtk      # parallel VTK (no field output is written)
SimulationName    = scalingGEM3D

#  %%%%%%%%%%%%%%%%%%% Magnetic Reconnection %%%%%%%%%%%%%%%%%%
B0x = 0.0195
B0y = 0.0
B0z = 0.0
delta = 0.5

#  %%%%%%%%%%%%%%%%%%% TIME %%%%%%%%%%%%%%%%%%
dt = 0.01         # dt = time step
ncycles = 101     # one warm-up cycle and 100 measured cycles
th = 1.0          # th = decentering parameter
c = 1.0

#  %%%%%%%%%%%%%%%%%%% SMOOTH %%%%%%%%%%%%%%%%%%
Smooth = 0.5      # Smoothing value (7-point filter)

Lx = 40   # Lx = simulation box length - x direction
Ly = 40   # Ly = simulation box length - y direction
Lz = 40   # Lz = simulation box length - z direction
nxc = 256  # nxc = number of cells - x direction
nyc = 256  # nyc = number of cells - y direction
nzc = 256  # nzc = number of cells - z direction

# %%%%%%%%%%%%%% MPI TOPOLOGY %%%%%%%%%%%%%%
# number of MPI subdomains in each direction: one rank per GPU
XLEN = 4
YLEN = 4
ZLEN = 4
# topology of subdomains in each dimension (1=true, 0=false)
PERIODICX = 1
PERIODICY = 0
PERIODICZ = 1

# %%%%%%%%%%%%%% PARTICLES %%%%%%%%%%%%%%%%%
#    ns = number of species
#    0 = electrons
#    1 = protons
#    ...
ns = 4

# qom = charge to mass ratio for different species
qom = -64.0 1.0 -64 1.0

# Initial density (make sure that plasma is neutral)
rhoINIT = 1.0 1.0 0.1 0.1
rhoINJECT = 0.0 0.0 0.0 0.0   # required; no open inflow faces here

# TrackParticleID[species] = 1=true, 0=false --> Assign ID to particles
TrackParticleID = 1 1 1 1

# npcelx = number of particles per cell - Direction X
npcelx = 7 7 7 7
# npcely = number of particles per cell - Direction Y
npcely = 8 8 8 8
# npcelz = number of particles per cell - Direction Z
npcelz = 5 5 5 5

# uth = thermal velocity for different species - Direction X
uth  = 0.045 0.0126 0.045 0.0126
# vth = thermal velocity for different species - Direction Y
vth  = 0.045 0.0126 0.045 0.0126
# wth = thermal velocity for different species - Direction Z
wth  = 0.045 0.0126 0.045 0.0126
# u0 = drift velocity   - Direction X
u0 = 0.0 0.0 0.0 0.0
# v0 = drift velocity   - Direction Y
v0 = 0.0 0.0 0.0 0.0
# w0 = drift velocity   - Direction Z
w0 = 0.0065 -0.0325 0.0 0.0

SortingCycle = 1

# &&&&&&&&&&&& boundary conditions &&&&&&&&&&&&&&&
#    EM field boundary condition
#    0 = perfect conductor
#    1 = perfect magnetic conductor
#    2 = open
bcEMfaceXright = 0
bcEMfaceXleft  = 0
bcEMfaceYright = 0
bcEMfaceYleft  = 0
bcEMfaceZright = 0
bcEMfaceZleft  = 0
#    Particles boundary condition
#    0 = exit
#    1 = perfect mirror
#    2 = open inflow
#    3 = open outflow
#    A periodic topology overrides the condition in that direction.
bcPfaceXright = 1
bcPfaceXleft  = 1
bcPfaceYright = 1
bcPfaceYleft  = 1
bcPfaceZright = 1
bcPfaceZleft  = 1

# GMRES solver stopping criterion tolerance
GMREStol = 1E-5
# mover predictor corrector iterations
NiterMover = 10
# overlap the field solver's halo exchanges with computation (1 = on, 0 = off)
HaloOverlap = 1

# %%%%%%%%%%%%%% OUTPUT: none, so that only the cycle is timed %%%%%%%%%%%%%%
FieldOutputCycle = 0
ParticlesOutputCycle = 0
DiagnosticsOutputCycle = 0
DataAnalysisCycle = 0
RestartOutputCycle = 0
CallFinalize = 0
