# Runtime input options configured for this 2D GEMHarris reconnection run.
# Controls for other cases or disabled features are kept at inert defaults.
# Compile-time constants in iPIC3Dlib.cu are not input-file options.
# Brackets show the value used when a key is omitted; required keys have no default.

# %%%%%%%%%%%%%%%%%%%% RUN AND I/O %%%%%%%%%%%%%%%%%%%%
SaveDirName    = Le2GEM15ppc            # Fresh-run output directory [default: data]
RestartDirName = Le2GEM15ppc            # Checkpoint directory [default: data]
Case           = GEMHarris              # Case-sensitive initialization case [required]
SimulationName = GEMHarris              # Output dataset name [required]
# Field backends (build-dependent): shdf5, phdf5, pvtk, nbcvtk, H5hut, adios2.
WriteMethod    = pvtk                   # [required]

# %%%%%%%%%%%%%%%%%%%% TIME INTEGRATION %%%%%%%%%%%%%%%%%%%%
dt      = .065                          # Time step [required]
ncycles = 12001                         # Cycles in this run [required]
th      = 1.0                           # Implicit decentering parameter [default: 1.0]
c       = 1.0                           # Normalized light speed [default: 1.0]

# %%%%%%%%%%%%%%%%%%%% INITIAL FIELDS %%%%%%%%%%%%%%%%%%%%
# Harris-sheet asymptotic field (B0x) and guide field (B0z).
B0x = 0.025                             # [default: 0.0]
B0y = 0.00                              # [default: 0.0]
B0z = 0.01                              # [default: 0.0]

delta = 0.5                             # Current-sheet half-thickness [default: 0.5]

# GEMHarris perturbation and current initialization.
pertGEM                 = 0.0           # GEM tearing perturbation amplitude [default: 0.0]
pertHump                = 0.12566       # Gaussian hump perturbation amplitude; 0 disables [default: 0.0]
deltaxHump              = 1.0           # Hump x-envelope width in units of delta [default: 8.0]
deltayHump              = 1.0           # Hump y-envelope width in units of delta [default: 4.0]
kxHump                  = 0.62832       # Hump x-wavenumber; <0 uses 2*PI/Lx [default: -1.0]
kyHump                  = 0.62832       # Hump y-wavenumber; <0 uses PI/Ly [default: -1.0]
currentFromAmpere       = 1             # J from curl(B) with normalized u0/v0/w0 weights [default: 0]
spatiallyVaryingThermal = 1             # Local thermal speed from reference-state pressure [default: 0]
# To match the GEM case exactly (pertX=0.4, delta=0.5), set pertGEM = 0.0,
# pertHump = 0.12566 (0.4*PI/10), deltaxHump = deltayHump = 1.0,
# kxHump = kyHump = 0.62832 (PI/(10*delta)), currentFromAmpere = 0 and
# spatiallyVaryingThermal = 0.

Smooth      = 0.2                       # Smoothing coefficient; 1 disables [default: 1.0]
SmoothNiter = 6                         # Smoothing passes [default: 6]

PoissonCorrection      = no             # Exact "yes" enables div(E) cleaning [default: no]
PoissonCorrectionCycle = 10             # div(E) cleaning interval [default: 10]
divBCorrection         = no             # Exact "yes" enables div(B) cleaning [default: no]
divBCorrectionCycle    = 10             # div(B) cleaning interval [default: 10]

# %%%%%%%%%%%%%%%%%%%% DOMAIN AND TOPOLOGY %%%%%%%%%%%%%%%%%%%%
Lx = 20.0                               # Global x length [default: 10.0]
Ly = 10.0                               # Global y length [default: 10.0]
Lz = 1.0                                # Global z length [default: 10.0]

nxc = 512                               # Global x cells [default: 64]
nyc = 256                               # Global y cells [default: 64]
nzc = 1                                 # Global z cells [default: 64]

# XLEN*YLEN*ZLEN must equal the MPI process count.
XLEN = 2                                # MPI subdomains in x [default: 1]
YLEN = 2                                # MPI subdomains in y [default: 1]
ZLEN = 1                                # MPI subdomains in z [default: 1]

# Periodicity; omitted particle flags inherit these values. 1=periodic, 0=nonperiodic.
PERIODICX = 1                           # [default: true]
PERIODICY = 0                           # [default: true]
PERIODICZ = 1                           # [default: true]

# %%%%%%%%%%%%%%%%%%%% PARTICLES %%%%%%%%%%%%%%%%%%%%
# Species: current-sheet e-, i+; background e-, i+.
ns = 4                                  # Total species count [required]

# Initial density
rhoINIT   = 0.969  0.969  0.23  0.23    # Initial densities [required]
rhoINJECT = 0.0    0.0    0.0   0.0     # Boundary injection densities [required]

npcelx = 8  8  8  8                     # Particles per cell in x [required]
npcely = 8  8  8  8                     # Particles per cell in y [required]
npcelz = 8  8  8  8                     # Particles per cell in z [required]

# qom = charge to mass ratio for different species
#     e_sheet  i_sheet  e_bg    i_bg
qom = -400.0   1.0      -400.0  1.0     # [required]

# Thermal velocity
uth = 0.146  0.0163  0.127  0.0142      # x thermal speeds [required]
vth = 0.146  0.0163  0.127  0.0142      # y thermal speeds [required]
wth = 0.146  0.0163  0.127  0.0142      # z thermal speeds [required]

# Drift velocity
u0 = 0.0     0.0      0.0  0.0          # x drift speeds [required]
v0 = 0.0     0.0      0.0  0.0          # y drift speeds [required]
w0 = 0.0042  -0.0021  0.0  0.0          # z drift speeds [required]

TrackParticleID = 0  0  0  0            # Per-species ID mask [default: all 0]

SortingCycle = 1                        # GPU cell-sort interval; 0 disables [default: 0]

# %%%%%%%%%%%%%%%%%%%% VELOCITY SPECTRA %%%%%%%%%%%%%%%%%%%%
# Generates 2D (v_par, v_perp with respect to B field) velocity spectra
# Spectra are generated per macrocell
# Requires compile-time MACROCELL_SPECTRA_ENABLE switch = True in /src/include/dataAnalysis/dataAnalysisConfig.cuh
# Default MACROCELL_SPECTRA_ENABLE = True
# Runs only when VelocitySpectra = 1 and all three macrocell sizes are > 0.
VelocitySpectra        = 0              # Runtime master switch; 0 disables [default: 0]
MacrocellNx            = 0              # Macrocell x size in local cells [default: 0]
MacrocellNy            = 0              # Macrocell y size in local cells [default: 0]
MacrocellNz            = 0              # Macrocell z size in local cells [default: 0]
VelocitySpectraSpecies = 0 0 0 0        # Per-species enable mask [default: all 0]

# %%%%%%%%%%%%%%%%%%%% BOUNDARY CONDITIONS %%%%%%%%%%%%%%%%%%%%
# Phi BC: 0/1=Dirichlet, 2=Neumann; periodicity overrides face values.
bcPHIfaceXright = 1                     # [default: 1]
bcPHIfaceXleft  = 1                     # [default: 1]
bcPHIfaceYright = 1                     # [default: 1]
bcPHIfaceYleft  = 1                     # [default: 1]
bcPHIfaceZright = 1                     # [default: 1]
bcPHIfaceZleft  = 1                     # [default: 1]

# EM BC: 0=conductor, 1=magnetic mirror, 2=open/inflow.
bcEMfaceXright = 0                      # [required]
bcEMfaceXleft  = 0                      # [required]
bcEMfaceYright = 0                      # [required]
bcEMfaceYleft  = 0                      # [required]
bcEMfaceZright = 0                      # [required]
bcEMfaceZleft  = 0                      # [required]

yes_sal      = 0                        # Enable absorbing layers [default: 0]
n_layers_sal = 3                        # Layer thickness in cells [default: 3]

# Particle BC: 0=exit, 1=mirror, 2=reemit, 3=open outflow, 4=open inflow.
bcPfaceXright = 1                       # [default: 1]
bcPfaceXleft  = 1                       # [default: 1]
bcPfaceYright = 1                       # [default: 1]
bcPfaceYleft  = 1                       # [default: 1]
bcPfaceZright = 1                       # [default: 1]
bcPfaceZleft  = 1                       # [default: 1]

ApplyInflowBcsEImage = 1                # Include inflow E terms [default: 1]

# %%%%%%%%%%%%%%%%%%%% NUMERICAL SOLVERS %%%%%%%%%%%%%%%%%%%%
CGtol      = 1E-3                       # CG tolerance; current call disabled [default: 1e-3]
GMREStol   = 1E-5                       # Maxwell GMRES/FGMRES tolerance [default: 1e-3]
NiterMover = 3                          # Predictor-corrector iterations [default: 3]

# GPU Maxwell solver:
SolverType = GMRES                      # [default: GMRES]

# GPU Chebyshev preconditioner for
# Poisson problems div(E)/div(B) cleaning.
PoissonChebMaxIter       = 10           # Preconditioner iterations [default: 10]
PoissonChebRescaleEigMin = 1.0          # Lower-bound multiplier [default: 1.0]
PoissonChebRescaleEigMax = 1.0          # Upper-bound multiplier [default: 1.0]

# %%%%%%%%%%%%%%%%%%%% OUTPUT AND RESTART %%%%%%%%%%%%%%%%%%%%
# Tags are joined with +; an empty tag writes nothing.
# FieldOutputTag: B, E.
# MomentsOutputTag: rho, J, P (PXX..PZZ), Q (heat flux) or one component
# (PXX, Qxyz, ...) for all species; append a species index (rho0, J1, P2)
# for one species or _tot (rho_tot, J_tot, P_tot, Q_tot) for the sum.
# ParticlesOutputTag: position, velocity, q, ID.
FieldOutputCycle       = 200                  # Field/moment interval; <=0 disables [default: 100]
FieldOutputTag         = B+E                  # Grid fields [default: empty]
MomentsOutputTag       = rho+J+P              # Species moments [default: empty]
ParticlesOutputCycle   = 0                    # Particle interval; <=0 disables [default: 0]
ParticlesOutputTag     = position+velocity+q  # Particle fields [default: empty]
DiagnosticsOutputCycle = 200                  # Scalar interval [default: FieldOutputCycle]
RestartOutputCycle     = 0                    # Checkpoint interval; <=0 disables [default: 5000]
CallFinalize           = 1                    # Final checkpoint if restart output enabled [default: true]
